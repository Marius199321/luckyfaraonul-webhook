// api/getUsedTickets.jsw

import { query } from 'wix-data';

/**
 * Returnează toate biletele folosite deja pentru un produs
 * @param {string} productId
 * @returns {Promise<number[]>}
 */
export async function getUsedTickets(productId) {
  const result = await query('TicketsPurchases')
    .eq('productId', productId)
    .find();

  const usedTickets = [];

  result.items.forEach(item => {
    if (Array.isArray(item.tickets)) {
      usedTickets.push(...item.tickets);
    }
  });

  return usedTickets;
}
